const slipWin  = legs => legs.every(l => l.res === 'win');
const slipOdds = legs => legs.reduce((a,l) => a*l.odds, 1);

/* ============ HOME ============ */
function renderHome(){
  document.getElementById('homeList').innerHTML = TODAY_TIPS.map((t,i) => `
    <article class="tip">
      <div class="tip-head">
        <span class="tag">${t.league}</span>
