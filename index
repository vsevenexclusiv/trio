  `).join('');
}

/* ============ RESULTS ============ */
let currentCat = 'free';

function renderResults(){
  const totals = {
    free:{ legs:0, wins:0 },
    twoOdds:{ slips:0, wins:0 },
    threeOdds:{ slips:0, wins:0 }
  };
  RESULTS.forEach(day => {
    day.free.forEach(l => { totals.free.legs++; if (l.res==='win') totals.free.wins++; });
    totals.twoOdds.slips++; if (slipWin(day.twoOdds)) totals.twoOdds.wins++;
    totals.threeOdds.slips++; if (slipWin(day.threeOdds)) totals.threeOdds.wins++;
  });

  let statHTML = '';
  if (currentCat === 'free'){
    const rate = totals.free.legs ? Math.round((totals.free.wins/totals.free.legs)*100) : 0;
    statHTML = `
      <div class="stat"><b>${totals.free.wins}/${totals.free.legs}</b><span>7-day record</span></div>
      <div class="stat"><b>${rate}%</b><span>Win rate</span></div>
      <div class="stat"><b>3</b><span>Singles / day</span></div>
    `;
  } else {
    const t = totals[currentCat];
    const rate = t.slips ? Math.round((t.wins/t.slips)*100) : 0;
    statHTML = `
      <div class="stat"><b>${t.wins}/${t.slips}</b><span>Slips won</span></div>
      <div class="stat"><b>${rate}%</b><span>Hit rate</span></div>
      <div class="stat"><b>${currentCat==='twoOdds'?'2':'3'}</b><span>Legs / slip</span></div>
    `;
  }
  document.getElementById('stats').innerHTML = statHTML;

  const slider = document.getElementById('resSlider');
  const dots   = document.getElementById('resDots');
  slider.scrollLeft = 0;

  const cardsHTML = RESULTS.map(day => {
    const d = new Date(); d.setDate(d.getDate() - day.offset);
    const dateStr = fmtDate(d);

    if (currentCat === 'free'){
      const wins = day.free.filter(l => l.res==='win').length;
      const badgeClass = wins === day.free.length ? 'win' : wins === 0 ? 'loss' : 'mixed';
      const legs = day.free.map(l => `
        <div class="leg">
          <div class="leg-info">
            <div class="lm">${l.match}</div>
            <div class="lt">${l.tip} · ${l.odds.toFixed(2)}</div>
          </div>
          <span class="pill ${l.res}">${l.res==='win'?winIcon:lossIcon}${l.score}</span>
        </div>
      `).join('');
      return `
        <div class="day">
          <div class="day-head">
            <span class="day-date">${dateStr}</span>
            <span class="badge ${badgeClass}">${wins}/${day.free.length} won</span>
          </div>
          ${legs}
        </div>`;
    }

    const legs = day[currentCat];
    const won = slipWin(legs);
    const total = slipOdds(legs);
    const legsHTML = legs.map(l => `
      <div class="leg">
        <div class="leg-info">
          <div class="lm">${l.match}</div>
          <div class="lt">${l.tip} · ${l.odds.toFixed(2)}</div>
        </div>
        <span class="pill ${l.res}">${l.res==='win'?winIcon:lossIcon}${l.score}</span>
      </div>
    `).join('');
    return `
      <div class="day">
        <div class="day-head">
          <span class="day-date">${dateStr}</span>
          <span class="badge ${won?'win':'loss'}">${won?'Won':'Lost'}</span>
        </div>
        ${legsHTML}
        <div class="slip-total"><span>Combined odds</span><b>${total.toFixed(2)}</b></div>
      </div>`;
  }).join('');

  slider.innerHTML = cardsHTML;
  dots.innerHTML = RESULTS.map((_,i) => `<span class="dot${i===0?' active':''}"></span>`).join('');
}

